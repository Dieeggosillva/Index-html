
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EXNOVA ROBÔ V18</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;padding:16px;background:#10151f;color:#fff;
  font-family:Arial,sans-serif
}
h2{color:#42a5ff;margin-top:4px}
.card{
  background:#202b3a;padding:15px;margin:12px 0;
  border-radius:10px;border:1px solid #344256
}
.valor{font-size:24px;font-weight:bold;color:#40df91}
button{
  width:100%;padding:15px;border:0;border-radius:8px;
  background:#1685e8;color:white;font-size:16px;
  font-weight:bold;margin:5px 0
}
button.parar{background:#596579}
.linha{display:flex;justify-content:space-between;gap:10px;margin:9px 0}
.verde{color:#00ff66}
.vermelho{color:#ff5555}
.azul{color:#00d5ff}
.roxo{color:#b060ff}
.amarelo{color:#ffdf55}
.muted{color:#aab7c8;font-size:13px}
#registro{white-space:pre-wrap;font-size:13px;overflow-wrap:anywhere}
.sinal{
  padding:10px;margin:7px 0;border-radius:7px;
  background:#172230;border-left:4px solid #728096
}
</style>
</head>

<body>

<h2>EXNOVA ROBÔ V18</h2>
<p class="muted">EUR/USD | BiQuote | Estratégia V17.9</p>

<div class="card">
  <b>Estado da conexão</b>
  <div id="estado" class="amarelo">Aguardando conexão</div>
  <div id="atualizacao" class="muted">Nenhuma atualização realizada</div>
</div>

<div class="card">
  <b>Cotação EUR/USD</b>
  <div class="valor" id="preco">---</div>
  <div id="fonte" class="muted">Aguardando dados</div>
</div>

<div class="card">
  <b>Dados recebidos</b>
  <div class="linha"><span>Velas M1 fechadas</span><b id="totalM1">0</b></div>
  <div class="linha"><span>Velas M5 completas</span><b id="totalM5">0</b></div>
  <div class="linha"><span>Lacunas M1 detectadas</span><b id="lacunas">0</b></div>
  <div class="linha"><span>Última vela M1</span><b id="ultimaVela">---</b></div>
</div>

<div class="card">
  <b>Estratégia original V17.9</b>
  <div class="linha"><span>Pré-CALL original</span><b class="azul">AZUL</b></div>
  <div class="linha"><span>Pré-PUT original</span><b class="roxo">ROXO</b></div>
  <div class="linha"><span>Espaçamento</span><b>3 velas</b></div>
  <div class="linha"><span>CALL confirmado</span><b class="verde">CALL</b></div>
  <div class="linha"><span>PUT confirmado</span><b class="vermelho">PUT</b></div>
</div>

<div class="card">
  <b>Módulo estratégico TESTE 01</b>
  <div class="linha"><span>Novo Pré-CALL</span><b class="verde">VERDE</b></div>
  <div class="linha"><span>Novo Pré-PUT</span><b class="vermelho">VERMELHO</b></div>
  <div class="linha"><span>Espaçamento</span><b>5 velas</b></div>
  <div class="muted">Módulo independente dos pré-alertas originais.</div>
</div>

<div class="card">
  <b>Último sinal identificado</b>
  <div id="ultimoSinal">Aguardando análise</div>
</div>

<div class="card">
  <b>Histórico de sinais</b>
  <div id="historico" class="muted">Nenhum sinal identificado.</div>
</div>

<button id="iniciar" onclick="iniciar()">CONECTAR E INICIAR ATUALIZAÇÃO</button>
<button class="parar" onclick="parar()">PARAR ATUALIZAÇÃO</button>

<div class="card">
  <b>Registro do sistema</b>
  <div id="registro">Robô V18 carregado. Aguardando conexão.</div>
</div>

<div class="card">
  <b>Execução de operações</b>
  <div class="amarelo">DESATIVADA</div>
  <div class="muted">
    Esta versão recebe dados e identifica sinais.
    Não realiza operações na Exnova.
  </div>
</div>

<script>
const URL_COTACAO = "https://biquote.io/api/EURUSD";
const URL_M1 = "https://biquote.io/api/EURUSD/ohlc?interval=1m&limit=300";

let temporizador = null;
let ocupado = false;
let ultimoSinalExibido = "";
let ultimoRegistro = "";

function elemento(id){
  return document.getElementById(id);
}

function registrar(texto){
  const hora = new Date().toLocaleTimeString("pt-BR");
  elemento("registro").textContent =
    "[" + hora + "] " + texto + "\n" +
    elemento("registro").textContent;
}

async function buscarJSON(url){
  const resposta = await fetch(url,{cache:"no-store"});
  if(!resposta.ok) throw new Error("Erro HTTP " + resposta.status);
  return await resposta.json();
}

function normalizarM1(barras){
  const mapa = new Map();

  for(const b of barras){
    if(!b || b.isOpen === true) continue;

    const tempo = Date.parse(b.openTime);
    const o = Number(b.open);
    const h = Number(b.high);
    const l = Number(b.low);
    const c = Number(b.close);

    if(!Number.isFinite(tempo) ||
       ![o,h,l,c].every(Number.isFinite)) continue;

    if(h < Math.max(o,c,l) || l > Math.min(o,c,h)) continue;

    mapa.set(tempo,{
      time:tempo,open:o,high:h,low:l,close:c
    });
  }

  return [...mapa.values()].sort((a,b)=>a.time-b.time);
}

function contarLacunasM1(velas){
  let total = 0;
  for(let i=1;i<velas.length;i++){
    const diferenca = velas[i].time-velas[i-1].time;
    if(diferenca !== 60000) total++;
  }
  return total;
}

function construirM5(m1){
  const grupos = new Map();

  for(const v of m1){
    const inicio = Math.floor(v.time/300000)*300000;
    if(!grupos.has(inicio)) grupos.set(inicio,[]);
    grupos.get(inicio).push(v);
  }

  const resultado = [];

  for(const [inicio,grupo] of grupos){
    grupo.sort((a,b)=>a.time-b.time);

    if(grupo.length !== 5) continue;

    let completo = true;

    for(let i=0;i<5;i++){
      if(grupo[i].time !== inicio+i*60000){
        completo = false;
        break;
      }
    }

    if(!completo) continue;

    resultado.push({
      time:inicio,
      open:grupo[0].open,
      high:Math.max(...grupo.map(v=>v.high)),
      low:Math.min(...grupo.map(v=>v.low)),
      close:grupo[4].close
    });
  }

  return resultado.sort((a,b)=>a.time-b.time);
}

function calcularEMA(valores,periodo){
  const resultado = new Array(valores.length).fill(null);
  if(valores.length < periodo) return resultado;

  let soma = 0;
  for(let i=0;i<periodo;i++) soma += valores[i];

  let anterior = soma/periodo;
  resultado[periodo-1] = anterior;

  const multiplicador = 2/(periodo+1);

  for(let i=periodo;i<valores.length;i++){
    anterior = (valores[i]-anterior)*multiplicador+anterior;
    resultado[i] = anterior;
  }

  return resultado;
}

function calcularRSI(velas,periodo=14){
  const resultado = new Array(velas.length).fill(null);
  if(velas.length <= periodo) return resultado;

  let ganhos = 0;
  let perdas = 0;

  for(let i=1;i<=periodo;i++){
    const variacao = velas[i].close-velas[i-1].close;
    if(variacao>0) ganhos += variacao;
    else perdas -= variacao;
  }

  let mediaGanho = ganhos/periodo;
  let mediaPerda = perdas/periodo;

  function valorRSI(){
    if(mediaPerda===0) return 100;
    const rs = mediaGanho/mediaPerda;
    return 100-(100/(1+rs));
  }

  resultado[periodo] = valorRSI();

  for(let i=periodo+1;i<velas.length;i++){
    const variacao = velas[i].close-velas[i-1].close;
    const ganho = Math.max(variacao,0);
    const perda = Math.max(-variacao,0);

    mediaGanho = (mediaGanho*(periodo-1)+ganho)/periodo;
    mediaPerda = (mediaPerda*(periodo-1)+perda)/periodo;

    resultado[i] = valorRSI();
  }

  return resultado;
}

function analisar(m1,m5){
  const closes1 = m1.map(v=>v.close);
  const closes5 = m5.map(v=>v.close);

  const ema9 = calcularEMA(closes1,9);
  const ema21 = calcularEMA(closes1,21);
  const rsi = calcularRSI(m1,14);
  const ema21M5 = calcularEMA(closes5,21);
  const sinais = [];

  let restanteCallOriginal = 0;
  let restantePutOriginal = 0;
  let restanteNovoCall = 0;
  let restanteNovoPut = 0;

  let indiceM5 = -1;

  for(let i=0;i<m1.length;i++){
    const fechamentoM1 = m1[i].time+60000;

    while(indiceM5+1<m5.length &&
          m5[indiceM5+1].time+300000<=fechamentoM1){
      indiceM5++;
    }

    const valoresProntos =
      ema9[i]!==null &&
      ema21[i]!==null &&
      rsi[i]!==null &&
      indiceM5>=22 &&
      ema21M5[indiceM5]!==null &&
      ema21M5[indiceM5-1]!==null &&
      ema21M5[indiceM5-2]!==null;

    if(!valoresProntos){
      restanteCallOriginal=Math.max(0,restanteCallOriginal-1);
      restantePutOriginal=Math.max(0,restantePutOriginal-1);
      restanteNovoCall=Math.max(0,restanteNovoCall-1);
      restanteNovoPut=Math.max(0,restanteNovoPut-1);
      continue;
    }

    const v=m1[i];
    const k=indiceM5;

    const fechamentoM5=m5[k].close;

    const tendenciaCall =
      fechamentoM5>ema21M5[k] &&
      ema21M5[k]>ema21M5[k-1];

    const tendenciaPut =
      fechamentoM5<ema21M5[k] &&
      ema21M5[k]<ema21M5[k-1];

    const distanciaMedias =
      Math.abs(calcularEMA(closes5,9)[k]-ema21M5[k]);

    const inclinacaoEMA =
      Math.abs(ema21M5[k]-ema21M5[k-2]);

    const mercadoLateral =
      distanciaMedias<fechamentoM5*0.00035 &&
      inclinacaoEMA<fechamentoM5*0.00025;

    const callForte =
      tendenciaCall &&
      v.close>v.open &&
      v.close>ema9[i] &&
      ema9[i]>ema21[i] &&
      rsi[i]>52;

    const putForte =
      tendenciaPut &&
      v.close<v.open &&
      v.close<ema9[i] &&
      ema9[i]<ema21[i] &&
      rsi[i]<48;

    const preCallBruto =
      tendenciaCall &&
      ema9[i]>ema21[i] &&
      rsi[i]>=45 &&
      rsi[i]<=52 &&
      !callForte;

    const prePutBruto =
      tendenciaPut &&
      ema9[i]<ema21[i] &&
      rsi[i]>=48 &&
      rsi[i]<=55 &&
      !putForte;

    const novoPrePutBruto =
      tendenciaPut &&
      !mercadoLateral &&
      ema9[i]<ema21[i] &&
      v.close<ema21[i] &&
      v.close>v.open &&
      rsi[i]>40 &&
      rsi[i]<55 &&
      !putForte;

    const novoPreCallBruto =
      tendenciaCall &&
      !mercadoLateral &&
      ema9[i]>ema21[i] &&
      v.close>ema21[i] &&
      v.close<v.open &&
      rsi[i]>45 &&
      rsi[i]<60 &&
      !callForte;

    if(callForte){
      sinais.push({time:v.time,tipo:"CALL CONFIRMADO",cor:"verde"});
    }

    if(putForte){
      sinais.push({time:v.time,tipo:"PUT CONFIRMADO",cor:"vermelho"});
    }

    if(preCallBruto && restanteCallOriginal<=0){
      sinais.push({time:v.time,tipo:"PRÉ-CALL ORIGINAL",cor:"azul"});
      restanteCallOriginal=3;
    }else if(restanteCallOriginal>0){
      restanteCallOriginal--;
    }

    if(prePutBruto && restantePutOriginal<=0){
      sinais.push({time:v.time,tipo:"PRÉ-PUT ORIGINAL",cor:"roxo"});
      restantePutOriginal=3;
    }else if(restantePutOriginal>0){
      restantePutOriginal--;
    }

    if(novoPreCallBruto && restanteNovoCall<=0){
      sinais.push({time:v.time,tipo:"NOVO PRÉ-CALL ESTRATÉGICO",cor:"verde"});
      restanteNovoCall=5;
    }else if(restanteNovoCall>0){
      restanteNovoCall--;
    }

    if(novoPrePutBruto && restanteNovoPut<=0){
      sinais.push({time:v.time,tipo:"NOVO PRÉ-PUT ESTRATÉGICO",cor:"vermelho"});
      restanteNovoPut=5;
    }else if(restanteNovoPut>0){
      restanteNovoPut--;
    }

    if(!preCallBruto && restanteCallOriginal>0) restanteCallOriginal--;
    if(!prePutBruto && restantePutOriginal>0) restantePutOriginal--;
    if(!novoPreCallBruto && restanteNovoCall>0) restanteNovoCall--;
    if(!novoPrePutBruto && restanteNovoPut>0) restanteNovoPut--;
  }

  return sinais;
}

function mostrarSinais(sinais){
  const recentes=sinais.slice(-30).reverse();

  if(recentes.length===0){
    elemento("ultimoSinal").textContent="Nenhum sinal identificado nas velas analisadas.";
    elemento("historico").textContent="Nenhum sinal identificado.";
    return;
  }

  const ultimo=recentes[0];
  elemento("ultimoSinal").textContent=ultimo.tipo+" — "+
    new Date(ultimo.time).toLocaleString("pt-BR");

  elemento("historico").innerHTML="";

  for(const s of recentes){
    const div=document.createElement("div");
    div.className="sinal";

    const nome=document.createElement("b");
    nome.textContent=s.tipo;
    nome.className=s.cor;

    const data=document.createElement("div");
    data.className="muted";
    data.textContent=new Date(s.time).toLocaleString("pt-BR");

    div.appendChild(nome);
    div.appendChild(data);
    elemento("historico").appendChild(div);
  }
}

async function atualizar(){
  if(ocupado) return;
  ocupado=true;

  try{
    elemento("estado").textContent="Recebendo dados da BiQuote...";
    elemento("estado").className="amarelo";

    const respostaM1=await buscarJSON(URL_M1);

    if(!Array.isArray(respostaM1.bars)){
      throw new Error("Formato de dados M1 inválido.");
    }

    const m1=normalizarM1(respostaM1.bars);
    const m5=construirM5(m1);

    elemento("totalM1").textContent=m1.length;
    elemento("totalM5").textContent=m5.length;
    elemento("lacunas").textContent=contarLacunasM1(m1);

    if(m1.length){
      elemento("ultimaVela").textContent=
        new Date(m1[m1.length-1].time).toLocaleTimeString("pt-BR");
    }

    if(m1.length<40 || m5.length<23){
      elemento("estado").textContent="Dados insuficientes para análise";
      elemento("estado").className="amarelo";
      registrar("Dados recebidos, mas ainda insuficientes para calcular todos os indicadores.");
    }else{
      const sinais=analisar(m1,m5);
      mostrarSinais(sinais);

      elemento("estado").textContent="CONECTADO — DADOS RECEBIDOS";
      elemento("estado").className="verde";

      registrar("Atualização concluída: "+m1.length+
        " velas M1 e "+m5.length+" velas M5 completas.");
    }

    elemento("atualizacao").textContent=
      "Última atualização: "+new Date().toLocaleTimeString("pt-BR");

    try{
      const cotacao=await buscarJSON(URL_COTACAO);
      const preco=Number(cotacao.mid);

      if(Number.isFinite(preco)){
        elemento("preco").textContent=preco.toFixed(5);
        elemento("fonte").textContent=
          "Fonte: "+(cotacao.source||"BiQuote")+
          " | Idade: "+(cotacao.quoteAgeSeconds??"indisponível")+" segundos";
      }
    }catch(erroCotacao){
      elemento("fonte").textContent=
        "Cotação direta indisponível; velas M1 continuam sendo utilizadas.";
    }

  }catch(erro){
    elemento("estado").textContent="ERRO NA CONEXÃO";
    elemento("estado").className="vermelho";
    registrar("Erro: "+erro.message);
  }finally{
    ocupado=false;
  }
}

function iniciar(){
  if(temporizador) clearInterval(temporizador);

  atualizar();
  temporizador=setInterval(atualizar,10000);

  elemento("estado").textContent="Iniciando conexão...";
  registrar("Atualização automática iniciada: intervalo de 10 segundos.");
}

function parar(){
  if(temporizador){
    clearInterval(temporizador);
    temporizador=null;
  }

  elemento("estado").textContent="Atualização parada";
  elemento("estado").className="amarelo";
  registrar("Atualização interrompida pelo usuário.");
}
</script>

</body>
</html>

