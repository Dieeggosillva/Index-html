<script>

/* =====================================
   CONFIGURAÇÃO DA FONTE DE DADOS
===================================== */

const URL_BIQUOTE =
 "https://biquote.io/api/EURUSD/ohlc?interval=1m&limit=300";

let temporizadorBiQuote=null;
let buscandoDados=false;
let ultimaListaM1=[];
let ultimaListaM5=[];
let ultimaOrigem="";

/* =====================================
   INDICADORES
===================================== */

function emaSeries(valores,periodo){
 const resultado=[];
 const k=2/(periodo+1);
 let anterior=valores[0];

 for(let i=0;i<valores.length;i++){
  if(i===0) anterior=valores[i];
  else anterior=valores[i]*k+anterior*(1-k);

  resultado.push(anterior);
 }
 return resultado;
}

function rsiSeries(valores,periodo=14){
 const resultado=Array(valores.length).fill(null);

 if(valores.length<=periodo) return resultado;

 let ganhos=0;
 let perdas=0;

 for(let i=1;i<=periodo;i++){
  const dif=valores[i]-valores[i-1];
  if(dif>0) ganhos+=dif;
  else perdas-=dif;
 }

 let ganhoMedio=ganhos/periodo;
 let perdaMedia=perdas/periodo;

 function calcularRSI(){
  if(perdaMedia===0) return 100;
  const rs=ganhoMedio/perdaMedia;
  return 100-(100/(1+rs));
 }

 resultado[periodo]=calcularRSI();

 for(let i=periodo+1;i<valores.length;i++){
  const dif=valores[i]-valores[i-1];

  ganhoMedio=
   (ganhoMedio*(periodo-1)+Math.max(dif,0))/periodo;

  perdaMedia=
   (perdaMedia*(periodo-1)+Math.max(-dif,0))/periodo;

  resultado[i]=calcularRSI();
 }

 return resultado;
}

/* =====================================
   VALIDAÇÃO
===================================== */

function validarVelas(velas){
 if(!Array.isArray(velas)) return false;
 if(velas.length<22) return false;

 return velas.every(v=>
  v &&
  ["open","high","low","close"].every(k=>
   Number.isFinite(Number(v[k]))
  )
 );
}

function atualizarTexto(id,texto,classe){
 const elemento=document.getElementById(id);
 elemento.textContent=texto;
 elemento.className=classe||"";
}

/* =====================================
   CONVERSÃO E ORGANIZAÇÃO M1
===================================== */

function normalizarM1(barras){

 if(!Array.isArray(barras)) {
  throw new Error("A resposta não contém uma lista de velas.");
 }

 const mapa=new Map();

 for(const v of barras){

  if(!v || v.isOpen===true) continue;

  const horario=new Date(v.openTime).getTime();

  if(!Number.isFinite(horario)) continue;

  const vela={
   openTime:new Date(horario).toISOString(),
   timestamp:horario,
   open:Number(v.open),
   high:Number(v.high),
   low:Number(v.low),
   close:Number(v.close),
   volume:Number(v.volume||0),
   tickVolume:Number(v.tickVolume||0)
  };

  if(
   !Number.isFinite(vela.open)||
   !Number.isFinite(vela.high)||
   !Number.isFinite(vela.low)||
   !Number.isFinite(vela.close)
  ) continue;

  if(
   vela.high<Math.max(vela.open,vela.close)||
   vela.low>Math.min(vela.open,vela.close)||
   vela.high<vela.low
  ) continue;

  mapa.set(horario,vela);
 }

 return Array.from(mapa.values())
  .sort((a,b)=>a.timestamp-b.timestamp)
  .slice(-300);
}

/* =====================================
   VERIFICAÇÃO DE LACUNAS M1
===================================== */

function contarLacunasM1(velas){

 let lacunas=0;

 for(let i=1;i<velas.length;i++){
  const diferenca=
   velas[i].timestamp-velas[i-1].timestamp;

  if(diferenca>60000) {
   lacunas+=Math.round(diferenca/60000)-1;
  }
 }

 return lacunas;
}

/* =====================================
   CONSTRUÇÃO M5
   SOMENTE CINCO M1 CONSECUTIVAS
===================================== */

function construirM5(velas){

 const grupos=new Map();

 for(const v of velas){

  const inicio=Math.floor(v.timestamp/300000)*300000;

  if(!grupos.has(inicio)) grupos.set(inicio,[]);

  grupos.get(inicio).push(v);
 }

 const resultado=[];

 for(const [inicio,grupo] of grupos){

  grupo.sort((a,b)=>a.timestamp-b.timestamp);

  if(grupo.length!==5) continue;

  let completo=true;

  for(let i=0;i<5;i++){
   const horarioEsperado=inicio+(i*60000);

   if(grupo[i].timestamp!==horarioEsperado){
    completo=false;
    break;
   }
  }

  if(!completo) continue;

  const abertura=grupo[0].open;
  const fechamento=grupo[4].close;

  const maxima=Math.max(...grupo.map(v=>v.high));
  const minima=Math.min(...grupo.map(v=>v.low));

  resultado.push({
   openTime:new Date(inicio).toISOString(),
   timestamp:inicio,
   open:abertura,
   high:maxima,
   low:minima,
   close:fechamento,
   volume:grupo.reduce((s,v)=>s+v.volume,0),
   tickVolume:grupo.reduce((s,v)=>s+v.tickVolume,0)
  });
 }

 return resultado.sort((a,b)=>a.timestamp-b.timestamp);
}

/* =====================================
   EXIBIÇÃO DOS DADOS
===================================== */

function exibirDados(m1,m5){

 document.getElementById("m1").value=
  JSON.stringify(m1,null,1);

 document.getElementById("m5").value=
  JSON.stringify(m5,null,1);

 document.getElementById("totalM1").textContent=m1.length;
 document.getElementById("totalM5").textContent=m5.length;

 ultimaListaM1=m1;
 ultimaListaM5=m5;

 const lacunas=contarLacunasM1(m1);

 if(lacunas===0){
  atualizarTexto(
   "lacunas",
   "Nenhuma lacuna identificada na sequência recebida.",
   "ok"
  );
 }else{
  atualizarTexto(
   "lacunas",
   "ATENÇÃO: "+lacunas+" minuto(s) ausente(s) na sequência M1. Não foram inventadas velas.",
   "erro"
  );
 }

 document.getElementById("m5Status").textContent=
  "Velas M5 completas formadas: "+m5.length;

 if(m1.length<22 || m5.length<22){
  document.getElementById("status").textContent=
   "AGUARDANDO QUANTIDADE SUFICIENTE DE VELAS";
  return;
 }

 analisar();
}

